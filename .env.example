NEXT_PUBLIC_APP_NAME=Home Mart

# --- Local dev (pick one) ---
# A) Spring Boot running on :5199 — direct API (optional; same-origin proxy also works):
# NEXT_PUBLIC_API_URL=http://localhost:5199
#
# B) No local backend — proxy to Render (recommended). Leave NEXT_PUBLIC_API_URL unset:
BACKEND_URL=https://home-mart-backend.onrender.com

# --- Vercel production (same-origin /api proxy) ---
# Set BACKEND_URL on Vercel. Leave NEXT_PUBLIC_API_URL unset in production.

# --- Alternative: direct cross-origin API (requires Cors_AllowedOrigins on Render) ---
# NEXT_PUBLIC_API_URL=https://home-mart-backend.onrender.com

# Firebase Web (Google / Apple sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
